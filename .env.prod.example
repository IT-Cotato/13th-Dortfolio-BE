# EC2의 ~/13th-Dortfolio-BE/.env 로 복사해서 실제 값을 채운다.
# 이 파일 자체는 예시이며, 실제 .env는 절대 커밋하지 않는다.

# --- Database ---
POSTGRES_DB=dortfolio
POSTGRES_USER=dortfolio
POSTGRES_PASSWORD=            # 반드시 강한 비밀번호로 변경

# --- JWT ---
JWT_SECRET=                   # openssl rand -base64 64
JWT_SALT=                     # openssl rand -hex 16

# --- Mail ---
MAIL_USERNAME=dotfolio.cotato@gmail.com
MAIL_PASSWORD=                # Google 앱 비밀번호

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ---
# AWS Bedrock (생성: Claude Haiku 4.5, 임베딩: Cohere Embed v4)
# 자격 증명은 아래 S3 항목의 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 를 함께 씁니다.
# 해당 IAM 사용자에 bedrock:InvokeModel 권한이 있어야 합니다.
# Bedrock 콘솔 모델 카탈로그에 표시되는 모델 ID 또는 추론 프로파일 ID
BEDROCK_GENERATION_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_EMBEDDING_MODEL_ID=global.cohere.embed-v4:0
# 비워두면 AWS_REGION을 씁니다.
BEDROCK_REGION=
# DB에 저장되는 임베딩 모델 이름. 벡터 인덱스(V24)가 이 값에 묶여 있으므로 바꾸지 않습니다.
EMBEDDING_MODEL_NAME=cohere-embed-v4
RECORD_ANALYSIS_ENABLED=true
RECORD_ANALYSIS_STRENGTH_CANDIDATE_LIMIT=5
RECORD_ANALYSIS_STRENGTH_MAX_COUNT=2
RECORD_ANALYSIS_STRENGTH_MIN_SIMILARITY=0.4
RECORD_ANALYSIS_EMBEDDING_MAX_CHARACTERS=12000

# --- Insight 직무 역량 추천 ---
INSIGHT_RECOMMENDATION_CANDIDATE_RATIO=0.1
INSIGHT_RECOMMENDATION_CANDIDATE_MIN=1
INSIGHT_RECOMMENDATION_CANDIDATE_MAX=20
# 운영 데이터의 유사도 분포를 확인한 뒤 조정한다.
INSIGHT_RECOMMENDATION_MIN_SIMILARITY=0.0
INSIGHT_RECOMMENDATION_MAX_ATTEMPTS=2
INSIGHT_RECOMMENDATION_INITIAL_BACKOFF=2s

# --- AWS S3 (메모 활동 사진, 프로필 이미지) ---
AWS_S3_BUCKET=dotfolio-images
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 도메인 / HTTPS ---
# Let's Encrypt 인증서를 발급받은 도메인. nginx 설정에 그대로 들어간다
DOMAIN=3.27.226.133.nip.io

# --- Frontend ---
FRONTEND_URL=https://dotfolio-theta.vercel.app
# CORS 허용 출처. 쉼표로 여러 개 지정 가능(프론트 로컬 개발용 주소를 함께 넣어둔다)
CORS_ALLOWED_ORIGINS=https://dotfolio-theta.vercel.app,http://localhost:5173,http://localhost:3000

# --- 배포 시 GitHub Actions가 주입하므로 비워둬도 된다 ---
# (수동으로 compose를 실행할 땐 GHCR 이미지 주소를 직접 넣어야 한다)
SPRING_IMAGE=
FASTAPI_IMAGE=
