# EC2의 ~/13th-Dortfolio-BE/.env 로 복사해서 실제 값을 채운다.
# 이 파일 자체는 예시이며, 실제 .env는 절대 커밋하지 않는다.

# --- Database ---
POSTGRES_DB=dortfolio
POSTGRES_USER=dortfolio
POSTGRES_PASSWORD=            # 반드시 강한 비밀번호로 변경

# --- JWT ---
JWT_SECRET=                   # openssl rand -base64 64
JWT_SALT=                     # openssl rand -hex 16

# --- Mail ---
MAIL_USERNAME=dotfolio.cotato@gmail.com
MAIL_PASSWORD=                # Google 앱 비밀번호

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- AI ---
GEMINI_API_KEY=
RECORD_ANALYSIS_ENABLED=true

# --- AWS S3 (메모 활동 사진, 프로필 이미지) ---
AWS_S3_BUCKET=dotfolio-images
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- 도메인 / HTTPS ---
# Let's Encrypt 인증서를 발급받은 도메인. nginx 설정에 그대로 들어간다
DOMAIN=3.27.226.133.nip.io

# --- Frontend ---
FRONTEND_URL=https://dotfolio-theta.vercel.app
# CORS 허용 출처. 쉼표로 여러 개 지정 가능(프론트 로컬 개발용 주소를 함께 넣어둔다)
CORS_ALLOWED_ORIGINS=https://dotfolio-theta.vercel.app,http://localhost:5173,http://localhost:3000

# --- 배포 시 GitHub Actions가 주입하므로 비워둬도 된다 ---
# (수동으로 compose를 실행할 땐 GHCR 이미지 주소를 직접 넣어야 한다)
SPRING_IMAGE=
FASTAPI_IMAGE=
