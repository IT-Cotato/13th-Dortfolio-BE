# docker-compose.local.yml 용 환경 변수 예시
# 사용법: cp .env.example .env  (그리고 필요한 값 채우기)

POSTGRES_DB=dortfolio
POSTGRES_USER=dortfolio
POSTGRES_PASSWORD=dortfolio
POSTGRES_PORT=5432

FASTAPI_PORT=8000
FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_CONNECT_TIMEOUT=3s
FASTAPI_READ_TIMEOUT=30s
GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_HTTP_TIMEOUT_SECONDS=25

# Record AI Analysis
RECORD_ANALYSIS_ENABLED=true
RECORD_ANALYSIS_STRENGTH_CANDIDATE_LIMIT=5
RECORD_ANALYSIS_STRENGTH_MAX_COUNT=2
RECORD_ANALYSIS_STRENGTH_MIN_SIMILARITY=0.4
RECORD_ANALYSIS_EMBEDDING_MAX_CHARACTERS=12000
RECORD_ANALYSIS_ASYNC_CORE_POOL_SIZE=2
RECORD_ANALYSIS_ASYNC_MAX_POOL_SIZE=5
RECORD_ANALYSIS_ASYNC_QUEUE_CAPACITY=100
RECORD_ANALYSIS_LOCK_TIMEOUT=5s

# Insight Job Recommendation
INSIGHT_RECOMMENDATION_CANDIDATE_RATIO=0.1
INSIGHT_RECOMMENDATION_CANDIDATE_MIN=1
INSIGHT_RECOMMENDATION_CANDIDATE_MAX=20
INSIGHT_RECOMMENDATION_MIN_SIMILARITY=0.0
INSIGHT_RECOMMENDATION_MAX_ATTEMPTS=2
INSIGHT_RECOMMENDATION_INITIAL_BACKOFF=2s

# AI Record Matching
MATCHING_DEFAULT_RECORD_LIMIT=3
MATCHING_MAX_RECORD_LIMIT=10
MATCHING_CANDIDATE_RECORD_LIMIT=10
MATCHING_INDEXED_EMBEDDING_MODELS=gemini-embedding-2
MATCHING_QUESTION_MAX_LENGTH=500
MATCHING_MIN_MATCH_RATE=30
MATCHING_DAILY_AI_REQUEST_LIMIT=20
MATCHING_DAILY_AI_REQUEST_TTL=1d
MATCHING_DAILY_AI_REQUEST_ZONE=Asia/Seoul

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_SALT=your_32_character_hex_salt_here

# Mail Configuration
MAIL_USERNAME=dotfolio.cotato@gmail.com
MAIL_PASSWORD=your_google_app_password_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
